# ========================================================
# AspectSense AI — Root .gitignore
# ========================================================

# Environment Variables & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python
backend/venv/
backend/.venv/
venv/
.venv/
env/
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
*.local
vite.config.js.timestamp-*

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
test_out.txt

# Editor & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
