# ========================================================
# Environment Variables Example — AspectSense AI
# Copy this file to .env and fill in your credentials
# ========================================================

# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL — Direct connection params
SUPABASE_HOST=aws-0-ap-southeast-2.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.your_project_ref
SUPABASE_PASSWORD=your_supabase_database_password

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Rainforest API (Amazon product data & reviews)
# Get your API key at: https://www.rainforestapi.com
RAINFOREST_API_KEY=your_rainforest_api_key

# AI Summary (LangChain LLM — optional)
# Options: 'openai', 'google', or leave blank for extractive fallback
SUMMARY_PROVIDER=
SUMMARY_MODEL=

# OpenAI API Key (if SUMMARY_PROVIDER=openai)
OPENAI_API_KEY=

# Google Gemini API Key (if SUMMARY_PROVIDER=google)
GOOGLE_API_KEY=

# NLP Model Override (optional)
ABSA_MODEL=gauneg/roberta-base-absa-ate-sentiment

# Caching (optional Redis)
CACHE_TYPE=simple
# REDIS_URL=redis://localhost:6379/0
